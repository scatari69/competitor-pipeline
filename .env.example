# Скопіюйте в .env і змініть за потреби: cp .env.example .env

# Порт панелі на хості
APP_PORT=5000

# Порт Ollama на хості (лише для налагодження)
OLLAMA_PORT=11434

# Модель Ollama. Більша модель — кращі формулювання, але повільніше:
#   gemma3:4b (за замовчуванням), gemma3:12b, qwen3:8b, llama3.1:8b
LLM_MODEL=gemma3:4b

# Контекст у токенах
LLM_NUM_CTX=8192

# Таймаут одного кроку аналізу в секундах.
# На CPU крок може тривати хвилини — не ставте менше 300.
LLM_TIMEOUT=600

LLM_TEMPERATURE=0.2
LLM_RETRIES=2
